<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island" Width="480" Height="660"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" UseLayoutRounding="False" SnapsToDevicePixels="False"
        FontFamily="{StaticResource TextFont}">
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="IslandScale" ScaleX="0.85" ScaleY="0.85"/>
        </Grid.LayoutTransform>
        <Border x:Name="RootBorder" Width="200" Height="34" Margin="0,8,0,0"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                CornerRadius="17" BorderThickness="1" BorderBrush="#26FFFFFF"
                Background="#FF050507" ClipToBounds="True"
                MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave"
                MouseLeftButtonUp="Root_MouseLeftButtonUp">
            <Border.ContextMenu>
                <ContextMenu x:Name="IslandMenu">
                    <MenuItem Header="Настройки…" Click="Settings_Click"/>
                    <MenuItem Header="Обновить программу…" Click="UpdateApp_Click"/>
                    <Separator/>
                    <MenuItem Header="Закрыть Dynamic Island" Click="Exit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!-- ===== Компактная капсула ===== -->
                <Grid x:Name="CompactPanel" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CompactArtBox" Width="22" Height="22" CornerRadius="6" Background="#2C2C2E"
                            HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="True"
                            Visibility="Collapsed">
                        <Image x:Name="CompactArt" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock x:Name="ClockText" Grid.Column="1" Text="--:--" Foreground="#F2F2F7"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <StackPanel x:Name="EqPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="#30D158"
                                       Margin="1,0" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="EqScale1" ScaleY="0.25"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="#30D158"
                                       Margin="1,0" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="EqScale2" ScaleY="0.25"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="#30D158"
                                       Margin="1,0" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="EqScale3" ScaleY="0.25"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="#30D158"
                                       Margin="1,0" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="EqScale4" ScaleY="0.25"/></Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>
                        <Button x:Name="CompactPlayButton" Style="{StaticResource TransportButton}"
                                Width="26" Height="24" Margin="4,0,0,0" Visibility="Collapsed"
                                Click="PlayPause_Click" ToolTip="Пауза / воспроизведение">
                            <Path x:Name="CompactPlayIcon" Data="{StaticResource PauseGeo}"
                                  Style="{StaticResource TransportIcon}" Height="11" StrokeThickness="1"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ===== Раскрытая панель ===== -->
                <Grid x:Name="ExpandedPanel" Visibility="Collapsed" Opacity="0"
                      Width="364" Height="520" Margin="0,22,0,0"
                      HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="PanelShift" Y="-14"/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Часы и дата -->
                    <Grid Grid.Row="0" Margin="6,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ClockBig" Text="--:--" Foreground="White" FontSize="34"
                                   FontWeight="Light" FontFamily="{StaticResource DisplayFont}"/>
                        <TextBlock x:Name="DateText" Grid.Column="1" Text=" " Foreground="#98989D" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,9"/>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE713;"
                                Width="32" Height="30" FontSize="15" Foreground="#98989D"
                                VerticalAlignment="Center" Click="OpenSettings_Click" ToolTip="Настройки"/>
                    </Grid>

                    <!-- Проигрыватель -->
                    <Border x:Name="PlayerCard" Grid.Row="1" Margin="0,12,0,0" Padding="14" CornerRadius="20" Background="#1C1C1E">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="56" Height="56" CornerRadius="12" Background="#2C2C2E" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="♪" Foreground="#636366" FontSize="26"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image x:Name="ArtImage" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TrackTitle" Text="Ничего не играет" Foreground="#F2F2F7"
                                               FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TrackArtist" Text="Откройте плеер"
                                               Foreground="#98989D" FontSize="12" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="ProgressTrack" Height="4" CornerRadius="2" Background="#3A3A3C">
                                    <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left"
                                            CornerRadius="2" Background="#F2F2F7"/>
                                </Border>
                                <Grid Grid.Row="1" Margin="0,5,0,0">
                                    <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#98989D" FontSize="10"/>
                                    <TextBlock x:Name="RemainingText" Text="" Foreground="#98989D" FontSize="10"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <Button Style="{StaticResource TransportButton}" Click="Previous_Click" ToolTip="Назад">
                                    <Path Data="{StaticResource PrevGeo}" Style="{StaticResource TransportIcon}"/>
                                </Button>
                                <Button Style="{StaticResource TransportButton}" Width="64" Margin="6,0" Click="PlayPause_Click">
                                    <Path x:Name="PlayIcon" Data="{StaticResource PlayGeo}"
                                          Style="{StaticResource TransportIcon}" Height="24"/>
                                </Button>
                                <Button Style="{StaticResource TransportButton}" Click="Next_Click" ToolTip="Далее">
                                    <Path Data="{StaticResource NextGeo}" Style="{StaticResource TransportIcon}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Громкость -->
                    <Grid x:Name="VolumeRow" Grid.Row="2" Margin="8,14,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE992;" FontFamily="{StaticResource IconFont}" Foreground="#98989D"
                                   FontSize="14" VerticalAlignment="Center"/>
                        <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource MacSlider}"
                                Margin="12,0" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock Grid.Column="2" Text="&#xE995;" FontFamily="{StaticResource IconFont}"
                                   Foreground="#98989D" FontSize="14" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Буфер обмена: заголовок и настройки -->
                    <StackPanel x:Name="ClipboardHeader" Grid.Row="3" Margin="6,18,6,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Буфер обмена" Foreground="#F2F2F7" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StatusText" Foreground="#0A84FF" FontSize="11" Margin="10,1,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <ToggleButton x:Name="RecordSwitch" Grid.Column="1" Style="{StaticResource MacSwitch}"
                                          IsChecked="True" Click="Record_Click"
                                          ToolTip="Запись буфера обмена вкл/выкл"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#2C2C2E" CornerRadius="8" Padding="2" HorizontalAlignment="Left"
                                    ToolTip="Сколько записей хранить">
                                <StackPanel x:Name="LimitPanel" Orientation="Horizontal">
                                    <RadioButton GroupName="Limit" Content="5" Tag="5" IsChecked="True"
                                                 Style="{StaticResource SegmentButton}" Checked="Limit_Checked"/>
                                    <RadioButton GroupName="Limit" Content="10" Tag="10"
                                                 Style="{StaticResource SegmentButton}" Checked="Limit_Checked"/>
                                    <RadioButton GroupName="Limit" Content="20" Tag="20"
                                                 Style="{StaticResource SegmentButton}" Checked="Limit_Checked"/>
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource TextAction}" Content="Очистить"
                                    HorizontalAlignment="Right" Click="Clear_Click"
                                    ToolTip="Удалить все записи, кроме закреплённых"/>
                        </Grid>
                    </StackPanel>

                    <!-- Список записей -->
                    <Border x:Name="ClipboardCard" Grid.Row="4" Background="#1C1C1E" CornerRadius="16" Padding="5">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="ClipboardItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" Background="Transparent" CornerRadius="10"
                                                    Margin="0,1" Padding="10,7,6,7" Cursor="Hand"
                                                    MouseLeftButtonUp="ClipboardItem_Click"
                                                    ToolTip="Нажмите, чтобы скопировать снова">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Preview}" Foreground="#F2F2F7" FontSize="12"
                                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}"
                                                                       Foreground="#98989D" FontSize="9" Margin="0,1,4,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding TimeText}" Foreground="#98989D" FontSize="10"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal"
                                                                Opacity="0" VerticalAlignment="Center" Margin="6,0,0,0">
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE718;"
                                                                Width="30" Height="28" FontSize="13"
                                                                Opacity="{Binding PinOpacity}" Click="Pin_Click"
                                                                ToolTip="Закрепить / открепить"/>
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;"
                                                                Width="30" Height="28" FontSize="13"
                                                                Foreground="#98989D" Click="Delete_Click" ToolTip="Удалить"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#2C2C2E"/>
                                                    <Setter TargetName="Actions" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="EmptyText" Text="Скопируйте текст — он появится здесь"
                                       Foreground="#636366" FontSize="12" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
