<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island" Width="190" Height="54"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" UseLayoutRounding="True">
    <Grid>
        <Border x:Name="RootBorder" MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave" Width="190" Height="54" HorizontalAlignment="Center" VerticalAlignment="Top"
                CornerRadius="27" BorderThickness="1" BorderBrush="#66FFFFFF"
                Background="#E8171B24" Padding="14,8" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.48" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid x:Name="CompactPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="#77D9B5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="DYNAMIC ISLAND" Foreground="#F4F6FA"
                               FontSize="10" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ClockText" Grid.Column="2" Text="--:--" Foreground="#DCE3EC"
                               FontSize="11" VerticalAlignment="Center"/>
                </Grid>

                <Grid x:Name="ExpandedPanel" Visibility="Collapsed" Margin="0,2,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="2,0,2,10">
                        <TextBlock Text="DYNAMIC ISLAND" Foreground="#F4F6FA" FontSize="10"
                                   FontWeight="Bold" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="DateText" Text=" " Foreground="#AEB7C5" FontSize="10"
                                   DockPanel.Dock="Right"/>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#26313E" BorderBrush="#425064" BorderThickness="1"
                            CornerRadius="14" Padding="11" Margin="0,0,0,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="МУЗЫКА" Foreground="#9EADBF" FontSize="9" FontWeight="Bold"/>
                                <TextBlock x:Name="TrackTitle" Text="Нет активного воспроизведения"
                                           Foreground="#F4F6FA" FontSize="12" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Margin="0,5,8,0"/>
                                <TextBlock x:Name="TrackArtist" Text="Запусти музыку в Spotify или другом приложении"
                                           Foreground="#AEB7C5" FontSize="10" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PreviousButton" Content="|◀" Margin="2" Padding="8,6" Click="Previous_Click"/>
                                <Button x:Name="PlayPauseButton" Content="▶" Margin="2" Padding="9,6" Click="PlayPause_Click"/>
                                <Button x:Name="NextButton" Content="▶|" Margin="2" Padding="8,6" Click="Next_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="2,0,2,6">
                            <TextBlock Text="БУФЕР ОБМЕНА" Foreground="#F4F6FA" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="ПОСЛЕДНИЕ 5" Foreground="#8F9BAA" FontSize="9" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <Border Grid.Row="1" Background="#202A36" BorderBrush="#3B4859" BorderThickness="1"
                                CornerRadius="12" Padding="5">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ClipboardItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button HorizontalContentAlignment="Left" Background="#293442"
                                                    BorderBrush="#39485B" Margin="2" Padding="8,6"
                                                    Click="ClipboardItem_Click" Tag="{Binding}">
                                                <TextBlock Text="{Binding DisplayText}" Foreground="#E7ECF3" FontSize="10"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="350"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="2,9,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Громкость" Foreground="#C8D0DB" FontSize="10" VerticalAlignment="Center"/>
                        <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                Margin="10,0" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="VolumeText" Grid.Column="2" Text="--%" Foreground="#C8D0DB"
                                   FontSize="10" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
